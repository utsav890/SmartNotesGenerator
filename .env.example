# ==============================================================================
# SmartNotes AI - Production Environment Variables Template
# Copy this file to .env and replace all placeholders with strong random values.
# NEVER commit real credentials or .env files to source control.
# ==============================================================================

# Application Environment Mode (production / development / testing)
ENVIRONMENT=production

# JWT Signing Secret (REQUIRED in production: minimum 32 random characters)
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters

# Google Gemini API Key (REQUIRED for audio transcription, study notes, quizzes, and RAG chat)
# Obtain at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Used by MySQL container in docker-compose)
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
MYSQL_DATABASE=smart_notes_db
MYSQL_USER=smartnotes_user
MYSQL_PASSWORD=replace_with_strong_mysql_user_password
DATABASE_URL=mysql+pymysql://smartnotes_user:replace_with_strong_mysql_user_password@localhost:3306/smart_notes_db

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Security & CORS Settings
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://smartnotes-ai-626471362775.asia-south1.run.app,http://localhost:5173

# Explicit Demo Account Seeding (Only permitted if ENVIRONMENT != production)
ENABLE_DEMO_SEEDING=false

# Outbound Email Service (Optional: for production verification & password reset emails)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_smtp_key
